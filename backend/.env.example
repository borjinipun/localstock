# Local dev defaults — mock providers. Copy to .env only if running WITHOUT docker.
SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DATABASE_URL=sqlite:///./db.sqlite3
REDIS_URL=redis://localhost:6379/0

# Voice orchestrator
VOICESVC_URL=http://localhost:8001
# Shared token between api <-> voice-svc (mirrored in voice-svc/.env)
SERVICE_TOKEN=dev-service-token

# Demo seed (docker entrypoint). Seed = cities/plans/shops/catalog data.
SEED_DEMO=1
DJANGO_SUPERUSER=1

# Provider switches (spec 08 §5). MVP ships mocks; real adapters raise NotImplementedError.
PROVIDER_TELEPHONY=mock      # mock | exotel
PROVIDER_WHATSAPP=mock       # mock | meta_cloud
PROVIDER_SMS=mock            # mock | dlt_aggregator
PROVIDER_PAYMENTS=mock       # mock | razorpay

# Penalties/caps per docs/03 §7 & docs/02 F-C-03
MAX_TARGETS_PER_WAVE=6
SPOT_CHECK_EXTRA=5
QUERY_BUDGET_PAISE=2500
FRESH_CATALOG_HOURS=48
